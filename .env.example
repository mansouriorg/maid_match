# Copy this file to .env. Never commit the .env file.
# Both values are public: they end up in the browser, so never put a secret here.

# Address of the API (the maidmatch-serveur project)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public address of this site, used for the sitemap and the sharing picture
NEXT_PUBLIC_SITE_URL=http://localhost:3001
